# Copy this file to .env and set values for your environment.
DH_STORE_MYSQL_HOST=host.docker.internal
DH_STORE_MYSQL_PORT=3306
DH_STORE_MYSQL_USERNAME=root
DH_STORE_MYSQL_PASSWORD=change-me

DH_ALERT_CHANNELS_DINGROBOT_PLATFORM=dingtalk
DH_ALERT_CHANNELS_DINGROBOT_WEBHOOK=
DH_LOG_ALERTHOOK_CHANNELS=dingRobot

# Per-service values. These defaults match the original shell launchers.
DH_ALERT_CUSTOMTAGS_NET1=data-house-net1-svc
DH_STORE_MYSQL_DATABASE_NET1=data_net1
DH_CFX_ADAPTERCONFIG_URL_NET1=http://172.16.29.19:12522
DH_ALERT_CUSTOMTAGS_NET71=data-house-net71-svc
DH_STORE_MYSQL_DATABASE_NET71=data_net71
DH_EVM_ADAPTERCONFIG_URL_NET71=http://172.16.29.19:28545
DH_EVM_CONFIG_FIRSTBLOCK_NET71=61464999
DH_ALERT_CUSTOMTAGS_NET1029=data-house-net1029-svc
DH_STORE_MYSQL_DATABASE_NET1029=data_1029
DH_CFX_ADAPTERCONFIG_URL_NET1029=http://172.16.2.240:12569
DH_ALERT_CUSTOMTAGS_NET1030=data-house-net1030-svc
DH_STORE_MYSQL_DATABASE_NET1030=data_1030
DH_EVM_ADAPTERCONFIG_URL_NET1030=http://172.16.2.240:28545
DH_EVM_CONFIG_FIRSTBLOCK_NET1030=36935000
DH_ALERT_CUSTOMTAGS_MONITOR=data-house-net1029-svc

# Optional: expose the monitor API on another host port.
DH_MONITOR_PORT=8080
